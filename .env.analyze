VITE_APP_ENV=production

VITE_BASE_URL=/

VITE_API_BASE_URL=/api

VITE_USE_MOCK=false

VITE_CESIUM_BASE_URL=/cesium/

VITE_ENABLE_CONSOLE=false

VITE_REQUEST_TIMEOUT=20000

VITE_MOCK_DELAY=0
