# =====================================================================
# 环境变量模板
# 使用方式：复制为 .env.development / .env.test / .env.production
# ---------------------------------------------------------------------
# 安全警告：
#   1. 所有 VITE_ 前缀变量都会被打进前端 JS 产物，任何人都可查看，
#      严禁填写数据库密码、第三方 Secret、加密密钥等敏感信息。
#   2. 真实密钥只能保存在服务端或 CI/CD 的秘密管理里。
# =====================================================================

# 应用标题（浏览器标签页与登录页展示）
VITE_APP_TITLE=企业后台管理系统

# 环境标识：development | test | production
VITE_APP_ENV=development

# 部署基础路径，必须与 vite.config.ts 的 base 取值一致
# 根路径部署填写 / ；子目录部署填写 /admin/（首尾都要有斜杠）
VITE_BASE_URL=/

# API 基础地址
# 推荐填写相对路径 /api 并配合 Nginx 反向代理，可以避免跨域问题；
# 若直连后端域名（如 https://api.example.com），后端必须正确配置 CORS。
VITE_API_BASE_URL=/api

# 是否启用内置 Mock 数据（true / false）
VITE_USE_MOCK=true

# Cesium 静态资源基础路径
# 本地同域名：/cesium/
# CDN 部署：https://cdn.example.com/cesium/
# 注意：结尾斜杠不能省略，否则 Cesium 拼接 Worker 路径时会出现 404
VITE_CESIUM_BASE_URL=/cesium/

# 是否打印调试日志
VITE_ENABLE_CONSOLE=true

# 请求超时时间（毫秒）
VITE_REQUEST_TIMEOUT=20000

# 认证模式
#   refresh = AccessToken + RefreshToken（推荐，支持无感刷新）
#   bearer  = 仅 AccessToken，过期即重新登录
#   cookie  = 服务端会话模式，此时需要后端处理 HttpOnly/Secure/SameSite 与 CSRF
VITE_AUTH_MODE=refresh

# Mock 响应延迟（毫秒），用于验证 loading 态与请求竞态
VITE_MOCK_DELAY=300

# 生产构建是否输出 hidden sourcemap（默认 false）
# 开启后 dist 体积约翻 3~4 倍，且 *.map 会随静态站点一起发布；
# 只有在需要错误监控还原堆栈时才启用，并在部署前把 *.map 从产物目录移除。
VITE_BUILD_SOURCEMAP=false
