# =====================================================================
# 本地开发环境
# 说明：所有 VITE_ 前缀变量都会被内联进前端产物，禁止写入任何密钥。
# =====================================================================

# 应用标题
VITE_APP_TITLE=企业后台管理系统

# 环境标识：development | test | production
VITE_APP_ENV=development

# 部署基础路径，需与 vite.config.ts 的 base 保持一致
# 部署到子目录时改为 /admin/（注意首尾都要有斜杠）
VITE_BASE_URL=/

# API 基础地址（本地走 Vite 代理，避免 CORS）
VITE_API_BASE_URL=/api

# 是否启用内置 Mock（无真实后端时设为 true）
VITE_USE_MOCK=true

# Cesium 静态资源基础路径（Workers / Assets / Widgets / ThirdParty）
VITE_CESIUM_BASE_URL=/cesium/

# 是否输出调试日志
VITE_ENABLE_CONSOLE=true

# 请求超时时间（毫秒）
VITE_REQUEST_TIMEOUT=20000

# 认证模式：refresh=AccessToken+RefreshToken（推荐）；bearer=仅AccessToken；cookie=服务端会话
VITE_AUTH_MODE=refresh

# Mock 模拟延迟（毫秒），用于观察 loading 与竞态
VITE_MOCK_DELAY=300
