# =====================================================================
# 生产环境
# 构建命令：pnpm build:prod （或 npm run build）
# =====================================================================

VITE_APP_TITLE=企业后台管理系统

VITE_APP_ENV=production

# 部署基础路径。
# 部署到站点根路径：/
# 部署到子目录：/admin/（必须与 Nginx location 保持一致，详见 docs/deployment.md）
VITE_BASE_URL=/

# 生产环境一律通过 Nginx 反向代理访问接口，不使用开发服务器代理
VITE_API_BASE_URL=/api

# 生产环境强制关闭 Mock
VITE_USE_MOCK=false

# Cesium 静态资源路径。可指向同域名目录，也可指向 CDN：
# 例如 https://cdn.example.com/cesium/
VITE_CESIUM_BASE_URL=/cesium/

# 生产环境关闭调试日志
VITE_ENABLE_CONSOLE=false

VITE_REQUEST_TIMEOUT=20000

VITE_AUTH_MODE=refresh

VITE_MOCK_DELAY=0

# 生产构建默认不产出 sourcemap：dist 里 41 MB 的 *.map 会占 72% 体积，
# 且 nginx 未拦截 *.map，等于公开源码。需要错误监控还原堆栈时改为 true。
VITE_BUILD_SOURCEMAP=false
