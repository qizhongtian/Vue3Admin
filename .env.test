# =====================================================================
# 测试环境
# 构建命令：pnpm build:test
# =====================================================================

VITE_APP_TITLE=企业后台管理系统

VITE_APP_ENV=test

VITE_BASE_URL=/

# 测试环境接口地址。
# 方案一（推荐）：相对路径 + Nginx 反向代理，不写死域名，无需处理跨域。
# 方案二：直连后端域名，例如 https://api-test.example.com，此时后端必须配置 CORS。
VITE_API_BASE_URL=/api

# 测试环境默认使用真实后端；如需临时验证 Mock 改为 true 并重新构建
VITE_USE_MOCK=false

VITE_CESIUM_BASE_URL=/cesium/

# 测试环境保留少量日志便于排障
VITE_ENABLE_CONSOLE=true

VITE_REQUEST_TIMEOUT=20000

VITE_AUTH_MODE=refresh

VITE_MOCK_DELAY=200
