{
  "name": "vue3-admin-framework",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "企业级 Vue 3 + TypeScript + Vite 前端基础框架（含认证、动态路由、权限、ofetch 请求层与可选 Cesium 模块）",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "vite",
    "dev:test": "vite --mode test",
    "dev:prod": "vite --mode production",
    "build": "vue-tsc -b --force && vite build --mode production",
    "build:test": "vue-tsc -b --force && vite build --mode test",
    "build:prod": "vue-tsc -b --force && vite build --mode production",
    "build:analyze": "vite build --mode analyze",
    "preview": "vite preview --port 4173",
    "preview:strict": "vite preview --port 4173 --strictPort",
    "typecheck": "vue-tsc -b --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "lint:style": "stylelint \"src/**/*.{scss,css}\"",
    "lint:style:fix": "stylelint \"src/**/*.{scss,css}\" --fix",
    "format": "prettier --write \"**/*.{ts,tsx,vue,js,mjs,cjs,json,scss,css,md,html}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,vue,js,mjs,cjs,json,scss,css,md,html}\"",
    "prepare": "husky"
  },
  "dependencies": {
    "echarts": "6.1.0",
    "lucide-vue-next": "1.0.0",
    "naive-ui": "2.45.3",
    "ofetch": "1.5.1",
    "pinia": "4.1.0",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "optionalDependencies": {
    "cesium": "1.135.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/coverage-v8": "5.0.5",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.13.0",
    "eslint-plugin-vue": "10.11.1",
    "husky": "9.1.7",
    "jsdom": "30.1.3",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "rollup-plugin-visualizer": "7.1.1",
    "sass": "1.106.0",
    "stylelint": "17.16.0",
    "stylelint-config-standard-scss": "17.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "vue-eslint-parser": "10.4.0",
    "vue-tsc": "3.3.13"
  }
}
