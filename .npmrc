# pnpm 配置
#
# strict-peer-dependencies=false
#   Vue / Vite / Naive UI / Cesium 生态中存在大量宽松 peer 声明，
#   严格校验会在安装期直接失败，这里统一放宽并在文档中记录差异。
strict-peer-dependencies=false

# auto-install-peers=true
#   自动补齐缺失的 peer 依赖，避免逐个手工添加。
auto-install-peers=true

# store-dir=./.pnpm-store
#   把 pnpm 内容寻址仓库放在项目内。
#   默认情况下 pnpm 会把 store 放在磁盘根目录（例如 E:\.pnpm-store），
#   在受限账户 / 沙箱环境下会出现 “Failed to write cafs: 拒绝访问 (os error 5)”。
#   本项目统一把 store 收敛到工作区内，保证任何环境都能安装成功。
#   .pnpm-store 已在 .gitignore 中忽略。
store-dir=./.pnpm-store

# node-linker=hoisted
#   pnpm 默认使用 isolated（符号链接）布局。
#   在受限账户 / 沙箱 / 某些 Windows 文件系统上没有创建符号链接的权限，
#   node_modules 会出现目录存在但关键包（vue / vite …）缺失的情况。
#   hoisted 布局把依赖平铺到 node_modules 根目录，兼容性最好。
#   若你的环境支持符号链接，可删掉这一行以使用默认布局。
node-linker=hoisted
